# Copy to .env and adjust. Every variable is prefixed with NETHERBRAIN_.
# .env is git-ignored: API keys must never be committed.

# OpenAI-compatible endpoint exposed by Ollama (local models, always enabled)
NETHERBRAIN_OLLAMA_BASE_URL=http://localhost:11434/v1

# Remote providers are enabled only when their key is set.
# OpenRouter (https://openrouter.ai/keys): one key, hundreds of models.
NETHERBRAIN_OPENROUTER_API_KEY=
# Only list the zero-cost ":free" models
NETHERBRAIN_OPENROUTER_FREE_ONLY=true
# Groq (https://console.groq.com/keys): very fast inference, free tier with rate limits.
NETHERBRAIN_GROQ_API_KEY=

# Seconds /api/models waits for each provider before marking it unavailable
NETHERBRAIN_PROVIDER_LIST_TIMEOUT=5

# Origins allowed to call the API from a browser (JSON list)
NETHERBRAIN_CORS_ORIGINS=["http://localhost:3000"]
