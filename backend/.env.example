# À copier en .env puis à adapter. Toutes les variables sont préfixées par NETHERBRAIN_.
# .env est ignoré par git : les clés d'API ne doivent jamais être commitées.

# Base PostgreSQL. Sans Docker pour l'API, lancez seulement la base : `docker compose up -d db`
NETHERBRAIN_DATABASE_URL=postgresql+asyncpg://netherbrain:netherbrain@localhost:5432/netherbrain

# Endpoint compatible OpenAI exposé par Ollama (modèles locaux, toujours activé)
NETHERBRAIN_OLLAMA_BASE_URL=http://localhost:11434/v1
# Fenêtre de contexte demandée à Ollama. Sa valeur par défaut (4096) est trop courte pour
# l'agent ; plus elle est grande, plus le modèle occupe de VRAM.
NETHERBRAIN_OLLAMA_CONTEXT_LENGTH=16384

# RAG : modèle d'embeddings servi par Ollama (vecteurs de 768 dimensions),
# à installer avec `ollama pull nomic-embed-text`
NETHERBRAIN_EMBEDDING_MODEL=nomic-embed-text
# Fichiers joints : au-delà de ce nombre de caractères (au total), ils ne partent plus en
# entier au modèle, seulement leurs passages les plus proches de la question (RAG).
NETHERBRAIN_ATTACHMENT_INLINE_CHARS=32000
# Nombre de passages envoyés dans ce cas
NETHERBRAIN_RAG_TOP_K=5
# Taille maximale d'un fichier joint (en Mo)
NETHERBRAIN_MAX_UPLOAD_MB=20
# Images jointes : nombre maximum envoyé au modèle à chaque message (les plus récentes)
NETHERBRAIN_MAX_IMAGES_SENT=8

# Conseiller de modèles : clé gratuite d'Artificial Analysis (https://artificialanalysis.ai/),
# pour des benchmarks publics mis à jour en continu. Sans elle, seule la grille intégrée sert.
NETHERBRAIN_ARTIFICIAL_ANALYSIS_API_KEY=
# Heures avant de redemander les benchmarks (l'API limite à 1 000 requêtes par jour)
NETHERBRAIN_BENCHMARKS_MAX_AGE_HOURS=24
# Le modèle qui lit les demandes, « fournisseur/modèle » ; vide : un modèle local choisi seul
NETHERBRAIN_ADVISOR_MODEL=
# VRAM de la carte graphique (Go), pour savoir quels modèles locaux y tiennent
NETHERBRAIN_GPU_VRAM_GB=16

# Projets : le dossier atteignable. Un projet peut être n'importe lequel de ses sous-dossiers,
# et l'agent peut y demander l'accès à d'autres dossiers, toujours avec votre accord. L'API
# n'accède à rien au-delà. Dans Docker, c'est votre dossier personnel (voir compose.yaml).
NETHERBRAIN_ACCESS_ROOT=~
# L'ancien dossier de travail : les projets créés avant y gardent leur chemin relatif. Avec
# Docker, il doit être dans le dossier personnel, seul monté dans le conteneur.
NETHERBRAIN_WORKSPACE_ROOT=~/netherbrain-workspace

# Les fournisseurs distants ne sont activés que si leur clé est renseignée.
# OpenRouter (https://openrouter.ai/keys) : une seule clé, des centaines de modèles.
NETHERBRAIN_OPENROUTER_API_KEY=
# Ne lister que les modèles gratuits (suffixe « :free »)
NETHERBRAIN_OPENROUTER_FREE_ONLY=true
# Serveur llama.cpp lancé à la main (llama-server), pour les modèles qu'Ollama ne sait pas lire,
# comme les GGUF ternaires. Vide : fournisseur désactivé. Dans Docker, la machine hôte est
# joignable à l'adresse host.docker.internal (voir LLAMACPP_BASE_URL dans compose.yaml).
NETHERBRAIN_LLAMACPP_BASE_URL=
# Groq (https://console.groq.com/keys) : inférence très rapide, offre gratuite avec limites.
NETHERBRAIN_GROQ_API_KEY=

# Secondes d'attente de /api/models pour chaque fournisseur avant de le déclarer indisponible
NETHERBRAIN_PROVIDER_LIST_TIMEOUT=5

# Agent de code : nombre maximum d'allers-retours modèle → outils pour une question,
# taille du résultat d'un outil renvoyé au modèle, délai d'une commande (s) et délai
# accordé à l'utilisateur pour autoriser ou refuser une action (s).
NETHERBRAIN_AGENT_MAX_STEPS=12
NETHERBRAIN_AGENT_MAX_OUTPUT_CHARS=8000
NETHERBRAIN_AGENT_COMMAND_TIMEOUT=120
NETHERBRAIN_AGENT_APPROVAL_TIMEOUT=300
# false : l'agent lit et modifie des fichiers, mais ne lance aucune commande
NETHERBRAIN_AGENT_ALLOW_COMMANDS=true

# Origines autorisées à appeler l'API depuis un navigateur (liste JSON)
NETHERBRAIN_CORS_ORIGINS=["http://localhost:3000"]
