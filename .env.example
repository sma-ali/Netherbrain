# Variables lues par Docker Compose (compose.yaml). À copier en .env à la racine, puis à adapter.
# Toutes sont facultatives : sans .env, les valeurs par défaut de compose.yaml s'appliquent.
# Les clés d'API des fournisseurs distants vont dans backend/.env (voir backend/.env.example).

# Mot de passe de la base PostgreSQL (publiée sur 127.0.0.1 seulement). À changer.
POSTGRES_PASSWORD=change-moi

# Ollama sur la machine hôte, vu depuis le conteneur de l'API
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Serveur llama.cpp lancé à la main sur l'hôte ; vide : fournisseur désactivé
LLAMACPP_BASE_URL=

# Ancien dossier de travail des projets, dans le dossier personnel (seul monté dans le conteneur)
# NETHERBRAIN_WORKSPACE=/home/vous/netherbrain-workspace
